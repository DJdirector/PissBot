# Copy this file to .env and fill it in. Never commit .env.
# The bot reads BOT_TOKEN from the environment, so load the file before starting:
#   set -a; . ./.env; set +a; ./build/pissbot
BOT_TOKEN=

# Reserved for the planned Twitch integration. Not used yet.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
